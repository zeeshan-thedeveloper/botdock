generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrganisationRole {
  OWNER
  ADMIN
  MEMBER
}

enum BotStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum ModelProvider {
  OPENAI
  ANTHROPIC
}

enum ProviderCredentialStatus {
  ACTIVE
  INVALID
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships                OrganisationMember[]
  botsCreated                Bot[]                @relation("BotCreatedBy")
  identities                 OAuthIdentity[]
  sessions                   AuthSession[]
  providerCredentialsCreated ProviderCredential[] @relation("ProviderCredentialCreatedBy")

  @@map("users")
}

model OAuthIdentity {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  email             String
  emailVerified     Boolean       @default(false)
  profileUrl        String?
  avatarUrl         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([email])
  @@map("oauth_identities")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             OrganisationMember[]
  bots                Bot[]
  providerCredentials ProviderCredential[]

  @@map("organisations")
}

model OrganisationMember {
  id             String           @id @default(cuid())
  organisationId String
  userId         String
  role           OrganisationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
  @@map("organisation_members")
}

model Bot {
  id                        String    @id @default(cuid())
  organisationId            String
  createdById               String
  providerCredentialId      String?
  name                      String
  description               String?
  status                    BotStatus @default(DRAFT)
  initials                  String?
  welcomeMessage            String    @default("Hi! I'm here to help with orders, returns, and account questions.")
  instructions              String    @default("You are a customer support assistant for this account.\nAnswer only using the provided knowledge sources.\nBe concise, friendly, and professional.\nIf policy details conflict, prefer the most recent source.\nEscalate billing disputes, account access issues, and refund exceptions.")
  tone                      String    @default("Friendly, precise, and calm")
  handoffBehavior           String    @default("Escalate after low-confidence answer")
  model                     String    @default("gpt-4o-mini")
  temperature               Float     @default(0.35)
  responseLength            String    @default("balanced")
  retrievalMode             String    @default("hybrid")
  maxSources                Int       @default(6)
  citationStyle             String    @default("inline_source_chips")
  widgetTheme               String    @default("Dark system default")
  widgetPosition            String    @default("Bottom right")
  strictKnowledge           Boolean   @default(true)
  promptInjectionProtection Boolean   @default(true)
  piiRedaction              Boolean   @default(true)
  collectFeedback           Boolean   @default(true)
  humanHandoff              Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("BotCreatedBy", fields: [createdById], references: [id])
  providerCredential ProviderCredential? @relation(fields: [providerCredentialId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([createdById])
  @@index([providerCredentialId])
  @@map("bots")
}

model ProviderCredential {
  id              String                   @id @default(cuid())
  organisationId  String
  provider        ModelProvider
  label           String
  encryptedSecret String
  last4           String
  status          ProviderCredentialStatus @default(INVALID)
  createdById     String
  lastValidatedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProviderCredentialCreatedBy", fields: [createdById], references: [id])
  bots         Bot[]

  @@unique([organisationId, provider, label])
  @@index([organisationId])
  @@index([createdById])
  @@map("provider_credentials")
}
