GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PROVIDER_CREDENTIAL_ENC_KEY=replace-with-at-least-32-characters-key-material

MINIO_ENDPOINT=http://localhost:9000
