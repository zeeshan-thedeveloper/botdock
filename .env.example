NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_BOTDOCK_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_BOTDOCK_ORGANISATION_ID=
DATABASE_URL=postgresql://botdock:botdock@localhost:5432/botdock?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
LOG_LEVEL=info
AUTH_SESSION_SECRET=replace-with-at-least-32-characters-local-secret
