AUTH_COOKIE_NAME=botdock_session
AUTH_OAUTH_STATE_COOKIE_NAME=botdock_oauth_state
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_OAUTH_CLIENT_ID=
